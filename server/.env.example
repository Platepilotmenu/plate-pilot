# Plate Pilot Backend Environment Template
PORT=5000
NODE_ENV=development

JWT_SECRET=your_jwt_secret_key_here

# Database Configuration (sqlite or mysql)
DB_TYPE=sqlite
DB_SQLITE_PATH=./data/platepilot.db

# MySQL / MariaDB (if using external server)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=platepilot

SUPER_ADMIN_PHONE=9999999999
SUPER_ADMIN_PASSWORD=admin123
SUPER_ADMIN_PIN=9999

CORS_ORIGIN=*
